# OpenAI-compatible LLM settings for natural language to SQL conversion.
# DeepSeek example (recommended for a DeepSeek key):
DEEPSEEK_API_KEY=your-deepseek-api-key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# OpenAI alternative:
# OPENAI_API_KEY=sk-your-openai-api-key
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*
